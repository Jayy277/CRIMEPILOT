      "item": [
        {
          "name": "Staff Login (Officer / Analyst / Admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usernameOrEmail\": \"rahulpandya@crimepilot.com\",\n  \"password\": \"password123\"\n}"
            }
          },
          "response": [
            {
              "name": "200 Success",
              "status": "OK",
              "code": 200,
              "body": "{\n  \"success\": true,\n  \"token\": \"jwt.access.token.string\",\n  \"user\": {\n    \"_id\": \"568\",\n    \"id\": 568,\n    \"name\": \"Rahul Pandya\",\n    \"email\": \"rahulpandya@crimepilot.com\",\n    \"role\": \"officer\",\n    \"isActive\": true\n  },\n  \"details\": {\n    \"badge_no\": \"BADGE-1025\",\n    \"contact\": \"+91 982591744\",\n    \"station\": {\n      \"id\": 1346,\n      \"policeStation\": \"Sola Police Station\",\n      \"city\": \"Ahmedabad\",\n      \"state\": \"Gujarat\"\n    }\n  }\n}"
